#!/usr/bin/env zsh
# Browse opencode sessions across all project directories.
#
#   ocs           pick a session and reopen it in its directory
#   ocs --print   pick a session and print "<session_id>\t<directory>" instead
#                 (used by the Neovim config to open it in a tmux split)
emulate -L zsh

local print_only=0
case $1 in
    '') ;;
    --print) print_only=1 ;;
    *) print -u2 "usage: ocs [--print]"; exit 2 ;;
esac

local db=$HOME/.local/share/opencode/opencode.db dw=42 row dir sid pv sessions=session

[[ -r $db ]] || { print -u2 "ocs: no db at $db"; exit 1; }

# OpenCode v2 keeps sessions in `session_v2` and messages in `session_message`
# (it migrates v1 sessions there); v1 (pinned 1.x) uses `session`/`message`/`part`.
if [[ -n $(sqlite3 "$db" "select 1 from sqlite_master where type = 'table' and name = 'session_v2';") ]]; then
    sessions=session_v2
    pv='sqlite3 "'$db'" "select data ->> '\''text'\''
            from session_message
            where session_id = {2} and type = '\''user'\''
            order by seq limit 1;"'
else
    pv='sqlite3 "'$db'" "select p.data ->> '\''text'\''
            from part p join message m on m.id = p.message_id
            where p.session_id = {2}
              and p.data ->> '\''type'\'' = '\''text'\''
              and m.data ->> '\''role'\'' = '\''user'\''
            order by p.time_created limit 1;"'
fi

row=$(sqlite3 -separator $'\x1f' "$db" "
      select strftime('%Y-%m-%d %H:%M', s.time_updated/1000, 'unixepoch', 'localtime'),
             replace(s.directory, '$HOME', '~'),
             coalesce(nullif(trim(s.title), ''), '(untitled)'),
             s.id,
             s.directory
      from $sessions s
      where s.time_archived is null
      order by s.time_updated desc;" \
    | awk -F$'\x1f' -v dw=$dw '
        function trunc(s, w) {
          return length(s) > w ? "\xe2\x80\xa6" substr(s, length(s) - w + 2) : s
        }
        { printf "\033[38;5;245m%s\033[0m  \033[38;5;110m%-*s\033[0m  \033[38;5;253m%s\033[0m\t%s\t%s\n",
                 $1, dw, trunc($2, dw), $3, $4, $5 }' \
    | fzf --ansi --delimiter=$'\t' --with-nth=1 \
          --prompt='  session  ' --pointer='▌' --info=inline-right \
          --layout=reverse --height=90% \
          --border=rounded --border-label=' opencode sessions ' \
          --color='border:238,label:110,prompt:110,pointer:212,hl:212,hl+:212,info:245' \
          --preview="$pv" --preview-window='down,45%,border-top,wrap' \
          --bind='ctrl-/:toggle-preview') || exit

sid=${${(s:	:)row}[2]}
dir=${${(s:	:)row}[3]}
[[ -d $dir ]] || { print -u2 "ocs: directory gone: $dir"; exit 1; }

if (( print_only )); then
    print -r -- "$sid"$'\t'"$dir"
    exit 0
fi
cd -- "$dir" && exec opencode "$dir" --session "$sid"
